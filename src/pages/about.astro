---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ValueCard from '../components/ValueCard.astro';
import FounderCard from '../components/FounderCard.astro';
import CTAStrip from '../components/CTAStrip.astro';
---

<BaseLayout
  title="About Prep Up"
  description="Learn about Prep Up Southcoast's mission, values, and the founders behind our college counseling program for New Bedford students."
>

  <PageHeader
    title="About"
    titleAccent="Prep Up."
    subtitle="A non-profit closing the guidance gap between independent school college counseling and the public school students of the Southcoast."
  />

  <!-- Mission section: editorial pull-quote -->
  <section class="relative py-28 md:py-36 px-6 grain">
    <div class="container-narrow">
      <p
        class="font-display text-2xl md:text-4xl lg:text-[2.6rem] font-light leading-[1.25] tracking-tight text-navy-ink mb-8"
        data-reveal
      >
        Prep Up offers a high-touch, cohort-based college advisory program designed to <span class="italic text-gold-dark">close any "guidance gap."</span>
      </p>

      <div class="space-y-6 max-w-2xl text-navy-ink/75 text-base md:text-[17px] leading-[1.75] font-light" data-reveal data-reveal-delay="120">
        <p>
          By adapting the college counseling models of top independent schools for a community-based setting, we provide a structured four-year program that can be tailored to meet students' needs and transform their potential into collegiate success.
        </p>
        <p>
          Our approach is process-driven and developmentally grounded — meeting students where they are in 9th grade and walking alongside them through every step to enrollment.
        </p>
      </div>
    </div>
  </section>

  <!-- Gold divider -->
  <div class="container-x-wide">
    <div class="gold-divider"></div>
  </div>

  <!-- Values section -->
  <section class="bg-white py-28 md:py-36 px-6">
    <div class="container-x-wide">
      <div class="mb-20" data-reveal>
        <h2 class="font-display text-4xl md:text-6xl lg:text-7xl font-medium text-navy-ink leading-[0.95] tracking-tightest max-w-4xl">
          Three principles<br/>
          <span class="italic font-light text-navy-ink/65">in everything we do.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-14 md:gap-16">
        <ValueCard
          number={1}
          title="Equity"
          description="A commitment to access and transparency. Every student deserves the same quality of guidance regardless of background or resources."
        />
        <ValueCard
          number={2}
          title="Partnership"
          description="A collaborative, process-driven method of support. We work alongside students and families, not just for them."
        />
        <ValueCard
          number={3}
          title="Aspiration"
          description="Setting the bar high for every student's future."
        />
      </div>
    </div>
  </section>

  <!-- Founders section -->
  <section class="bg-paper-warm py-28 md:py-40 px-6">
    <div class="container-x-wide">
      <div class="mb-20" data-reveal>
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-medium text-navy-ink leading-[1.05] tracking-tightest max-w-5xl">
          Meet the Founders.
        </h2>
      </div>

      <div class="space-y-24 md:space-y-32">
        <FounderCard
          index={0}
          name="Stuart Titus"
          initials="ST"
          photoSrc="/images/founders/stuart.jpg"
          photoAlt="Stuart Titus, co-founder of Prep Up"
          bio="Stuart has worked in independent schools for over three decades. He was the Director of Admission at Pingree School in MA; the Associate Director of College Counseling at St. George's School in RI and Mercersburg Academy in PA; and served as an interim college counselor at Tabor Academy in MA and San Francisco University High School in CA. He was a three-year letter winner on the football team at Bates College, where he earned a degree in English Literature."
        />
        <FounderCard
          index={1}
          name="Lucia Jaccaci"
          initials="LJ"
          photoSrc="/images/founders/lucia.jpg"
          photoAlt="Lucia Jaccaci, co-founder of Prep Up"
          bio="Lucia is an educator with 30 years of experience in independent school education. She has worked both as a classroom teacher and an administrator in the United States and in China. She taught history at St. George's School in RI and Cincinnati Country Day School in OH. While at YK Pao School in Shanghai she helped develop the college counseling program. Upon moving to the Southcoast, Lucia taught citizenship classes at the Immigrant Assistance Center in New Bedford, and is currently volunteering at Our Sister's School and Damien's Food Pantry."
        />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTAStrip
    headline="Want to learn more about what Prep Up can do for"
    headlineAccent="your student?"
    primaryCTA={{ label: 'Contact Us', href: '/contact' }}
    secondaryCTA={{ label: 'Support our mission', href: '/support' }}
  />

</BaseLayout>

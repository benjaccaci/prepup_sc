---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import PillarCard from '../components/PillarCard.astro';
import StudentSpread from '../components/StudentSpread.astro';
import CTAStrip from '../components/CTAStrip.astro';
---

<BaseLayout
  title="Prep Up Southcoast — College Access for All"
  description="Prep Up provides free, equitable college counseling to high school students in the New Bedford Southcoast area. Discover our four-year program."
>

  <!-- Hero -->
  <Hero
    primaryCTA={{ label: 'Explore the Program', href: '/program' }}
    secondaryCTA={{ label: 'Support our mission', href: '/support' }}
  />

  <!-- Marquee strip -->
  <Marquee />

  <!-- Mission section: editorial pull-quote -->
  <section class="relative py-28 md:py-40 px-6">
    <div class="container-narrow">
      <p
        class="font-display text-3xl md:text-5xl lg:text-[3.5rem] font-light leading-[1.15] tracking-tightest text-navy-ink"
        data-reveal
      >
        To provide <span class="italic">equitable</span>, process-driven college guidance to empower students in the Southcoast area
        <span class="relative inline-block">
          <span class="text-gold-dark italic">who face barriers</span>
          <span class="absolute -bottom-1 left-0 right-0 h-[3px] bg-gold/40 rounded-full"></span>
        </span>
        to higher education.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-white border-y border-navy-ink/[0.08] py-28 md:py-40 px-6">
    <div class="container-x-wide">
      <div class="mb-20 md:mb-24" data-reveal>
        <h2 class="font-display text-4xl md:text-6xl lg:text-7xl font-medium text-navy-ink leading-[0.95] tracking-tightest max-w-4xl">
          Three pillars guide<br/>
          <span class="italic font-light text-navy-ink/65">every student's journey.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-14 md:gap-16">
        <PillarCard
          number={1}
          index={0}
          title="Active Discovery"
          description={`A cohort-based search model that shifts the focus from "getting in" to "finding fit" through mutual support, self-reflection, and self-advocacy.`}
        />
        <PillarCard
          number={2}
          index={1}
          title="Narrative Cohesion"
          description="Synthesizing transcripts, testing, and extracurriculars into one clear, compelling, and authentic story about each student."
        />
        <PillarCard
          number={3}
          index={2}
          title="Process Driven"
          description="Utilizing essential criteria to drive each student's search process from 9th grade through senior year."
        />
      </div>

      <div class="mt-20 flex justify-center" data-reveal>
        <a href="/program" class="text-link text-navy-ink hover:text-gold-dark text-base">
          <span>Explore the full program</span>
          <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Editorial student spread: cohort outdoors -->
  <StudentSpread
    src="/images/students/cohort-outdoor.jpg"
    alt="A cohort of Prep Up students together on campus."
    caption="A Prep Up cohort. Students move through the four-year program together — building habits, sharing the search, and supporting each other through it."
    aspect="wide"
    variant="paper"
  />

  <!-- Founders teaser -->
  <section class="bg-paper-warm py-28 md:py-40 px-6">
    <div class="container-x-wide">
      <div class="mb-20" data-reveal>
        <h2 class="font-display text-4xl md:text-6xl lg:text-7xl font-medium text-navy-ink leading-[0.95] tracking-tightest max-w-5xl">
          Lifelong Independent School<br/>
          <span class="italic font-light text-navy-ink/65">Educators.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-14 md:gap-20 items-start">

        <!-- Stuart -->
        <article class="group" data-reveal>
          <div class="flex items-start gap-6 mb-7">
            <div class="shrink-0 relative w-20 h-20">
              <!-- Subtle gold ring on hover -->
              <div class="absolute -inset-1 rounded-full border border-gold/0 transition-all duration-500 group-hover:border-gold/50 group-hover:-inset-1.5 pointer-events-none"></div>
              <!-- Photo -->
              <div class="relative w-20 h-20 rounded-full overflow-hidden bg-paper-warm border border-navy-ink/10 transition-transform duration-700 group-hover:rotate-[6deg]">
                <img
                  src="/images/founders/stuart.jpg"
                  alt="Stuart Titus, co-founder of Prep Up"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="flex-1 pt-2">
              <h3 class="font-display text-2xl md:text-3xl font-medium text-navy-ink tracking-tight">Stuart Titus</h3>
            </div>
          </div>
          <p class="text-navy-ink/70 leading-[1.65] font-light text-[15px]">
            Three decades at independent schools, including Director of Admission at Pingree School and Associate Director of College Counseling at St. George's Schools and Mercersburg Academy.
          </p>
        </article>

        <!-- Lucia -->
        <article class="group" data-reveal data-reveal-delay="120">
          <div class="flex items-start gap-6 mb-7">
            <div class="shrink-0 relative w-20 h-20">
              <!-- Subtle gold ring on hover -->
              <div class="absolute -inset-1 rounded-full border border-gold/0 transition-all duration-500 group-hover:border-gold/50 group-hover:-inset-1.5 pointer-events-none"></div>
              <!-- Photo -->
              <div class="relative w-20 h-20 rounded-full overflow-hidden bg-paper-warm border border-navy-ink/10 transition-transform duration-700 group-hover:rotate-[6deg]">
                <img
                  src="/images/founders/lucia.jpg"
                  alt="Lucia Jaccaci, co-founder of Prep Up"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="flex-1 pt-2">
              <h3 class="font-display text-2xl md:text-3xl font-medium text-navy-ink tracking-tight">Lucia Jaccaci</h3>
            </div>
          </div>
          <p class="text-navy-ink/70 leading-[1.65] font-light text-[15px]">
            30 years as an educator and administrator in the U.S. and China. Helped develop college counseling at YK Pao School in Shanghai; currently volunteers at Our Sister's School in New Bedford.
          </p>
        </article>

      </div>

      <div class="mt-20 flex justify-center" data-reveal>
        <a href="/about" class="text-link text-navy-ink hover:text-gold-dark text-base">
          <span>Read more about our founders</span>
          <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <CTAStrip
    headline="Ready to invest in the next generation of"
    headlineAccent="Southcoast scholars?"
    primaryCTA={{ label: 'Get Involved', href: '/support' }}
    secondaryCTA={{ label: 'Contact us', href: '/contact' }}
  />

</BaseLayout>

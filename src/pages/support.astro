---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTAStrip from '../components/CTAStrip.astro';

// TODO: replace with the real donation platform URL (Stripe, PayPal, Donorbox, etc.)
const donateUrl = '#';
---

<BaseLayout
  title="Support Us"
  description="Support Prep Up's mission to provide free college counseling to Southcoast students. Donate to keep the program running for New Bedford, Fall River, and the surrounding Southcoast communities."
>

  <PageHeader
    edition="04"
    label="Make a Difference"
    title="Support"
    titleAccent="our mission."
    subtitle="Prep Up is sustained by community-led generosity. Whether you're a private donor, a local business, or a grantmaking foundation, your support fuels equitable college access for Southcoast students."
  />

  <!-- Donation banner -->
  <section class="relative bg-paper-warm border-b border-navy-ink/10 py-24 md:py-32 px-6 grain overflow-hidden">

    <!-- Decorative element -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-1/3 right-0 w-[480px] h-[480px] rounded-full bg-gold/[0.12] blur-3xl"></div>
    </div>

    <div class="relative container-wide">

      <!-- Editorial header -->
      <div class="mb-14 md:mb-20" data-reveal>
        <div class="flex items-center gap-3 mb-8">
          <span class="editorial-label">№ 02</span>
          <span class="h-px w-10 bg-navy-ink/20"></span>
          <span class="editorial-label">Donate</span>
        </div>

        <h2 class="font-display text-5xl md:text-7xl lg:text-[5.5rem] font-medium text-navy-ink leading-[0.95] tracking-tightest max-w-4xl">
          Make a gift <span class="italic font-light text-gold-dark">to Prep Up.</span>
        </h2>
      </div>

      <!-- Photo + donate card side by side -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-stretch">

        <!-- Photo (left, larger) -->
        <figure class="lg:col-span-7 relative" data-reveal data-reveal-delay="80">
          <div class="relative aspect-[5/4] md:aspect-[6/5] lg:aspect-[5/4] overflow-hidden rounded-2xl bg-navy-ink shadow-2xl shadow-navy-ink/15">
            <img
              src="/images/students/graduation.jpg"
              alt="Students at graduation, smiling in caps and gowns."
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <!-- Subtle warm tint to harmonize with paper-warm bg -->
            <div
              class="absolute inset-0 mix-blend-multiply pointer-events-none"
              style="background: linear-gradient(180deg, rgba(250,247,240,0) 50%, rgba(15,31,61,0.18) 100%);"
            ></div>
            <!-- Top + bottom gold rules -->
            <span class="absolute top-0 inset-x-0 h-px bg-gold/55"></span>
            <span class="absolute bottom-0 inset-x-0 h-px bg-gold/45"></span>

            <!-- Editorial corner markers -->
            <span class="absolute top-5 left-5 font-mono text-[10px] uppercase tracking-[0.22em] text-paper font-medium mix-blend-difference">PLATE · 02</span>
            <span class="absolute bottom-5 right-5 font-mono text-[10px] uppercase tracking-[0.22em] text-paper font-medium mix-blend-difference">MATRICULATION</span>
          </div>
          <figcaption class="font-display italic font-light text-base md:text-lg text-navy-ink/65 leading-relaxed mt-5 max-w-md">
            The outcome &mdash; what every gift to Prep Up is funding.
          </figcaption>
        </figure>

        <!-- Donate column (right) -->
        <div class="lg:col-span-5 flex flex-col gap-6 lg:justify-center" data-reveal data-reveal-delay="180">

          <p class="text-navy-ink/80 leading-[1.7] text-base md:text-lg font-light">
            Every contribution funds free college counseling for a Southcoast student &mdash; with no fees, no tuition, and no fundraising minimums.
          </p>

          <!-- Big donate button -->
          <a
            href={donateUrl}
            class="group inline-flex items-center justify-between gap-4 bg-navy-dark text-paper px-8 py-6 rounded-2xl transition-all duration-500 ease-out hover:bg-navy hover:shadow-2xl hover:shadow-navy-ink/20 hover:-translate-y-1 grain"
          >
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-paper/50 mb-1">Give now</p>
              <p class="font-display text-2xl md:text-3xl font-medium tracking-tight">Donate to Prep Up</p>
            </div>
            <span class="font-display text-3xl text-gold transition-transform duration-300 ease-out group-hover:translate-x-1">&rarr;</span>
          </a>

          <!-- Mailing address aside -->
          <div class="flex items-start gap-4 px-2 pt-2">
            <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-navy-ink/40 mt-1.5 shrink-0">Or</span>
            <p class="text-navy-ink/65 text-sm font-light leading-relaxed">
              Reach us at
              <a href="mailto:info@prepupsouthcoast.org" class="text-navy-ink hover:text-gold-dark transition-colors underline decoration-gold/40 decoration-2 underline-offset-4">
                info@prepupsouthcoast.org
              </a>
              to discuss a corporate sponsorship, multi-year gift, or grant opportunity.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Where the support goes -->
  <section class="bg-white border-b border-navy-ink/[0.08] py-24 md:py-32 px-6">
    <div class="container-x-wide">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">

        <div class="md:col-span-5" data-reveal>
          <div class="flex items-center gap-3 mb-8">
            <span class="editorial-label">№ 03</span>
            <span class="h-px w-10 bg-navy-ink/20"></span>
            <span class="editorial-label">Where it goes</span>
          </div>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-medium text-navy-ink leading-[0.95] tracking-tightest mb-6">
            Serving the<br/>
            <span class="italic font-light text-gold-dark">Southcoast.</span>
          </h2>
        </div>

        <div class="md:col-span-7 space-y-8 text-navy-ink/80 leading-[1.7] text-base md:text-[17px] font-light max-w-2xl" data-reveal data-reveal-delay="100">
          <p>
            Prep Up serves students from New Bedford, Fall River, and the surrounding Southcoast communities &mdash; adapting the high-touch college counseling model of independent schools for a community-based program at no cost to families.
          </p>
          <p>
            Your contribution underwrites the cohort programming, individual counseling sessions, campus visits, application support, and financial-aid guidance that make up the four-year Prep Up curriculum.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <CTAStrip
    eyebrow="Get involved"
    headline="Every dollar invested in Prep Up opens"
    headlineAccent="a door for a Southcoast student."
    primaryCTA={{ label: 'Contact Us', href: '/contact' }}
    secondaryCTA={{ label: 'Learn about the program', href: '/program' }}
  />

</BaseLayout>

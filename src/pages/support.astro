---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAStrip from '../components/CTAStrip.astro';

const pillars = [
  {
    icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
    title: 'Private Donors',
    description:
      'Fueling initial access through community-led philanthropy. Individual contributions of any size help us expand our cohort capacity and deepen our support for each student.',
  },
  {
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
    title: 'Corporate Partners',
    description:
      'Investing in the local talent they will hire one day. Southcoast businesses that partner with Prep Up are building a more educated, more competitive regional workforce.',
  },
  {
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    title: 'Grant Funding',
    description:
      'Integrating with local education initiatives. Prep Up is positioned to partner with foundations and grant-makers committed to closing equity gaps in higher education access across Massachusetts.',
  },
];
---

<BaseLayout
  title="Support Us"
  description="Support Prep Up's mission to provide free college counseling to Southcoast students. Learn how private donors, corporate partners, and grant-makers can get involved."
>

  <!-- Page header -->
  <header class="bg-navy text-white py-16 md:py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs font-semibold text-gold tracking-widest uppercase mb-3">Make a Difference</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight mb-4">Support Our Mission</h1>
      <p class="text-white/70 text-lg max-w-2xl leading-relaxed">
        Prep Up is sustained by community-led generosity. Whether you&rsquo;re a private donor, a local business, or a grantmaking foundation, your support fuels equitable college access for Southcoast students.
      </p>
    </div>
  </header>

  <!-- Funding pillars -->
  <section class="py-16 md:py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-semibold text-gold-dark tracking-widest uppercase mb-3">Ways to Give</p>
        <h2 class="section-heading">Three Ways to Support Prep Up</h2>
        <p class="page-subtitle mx-auto mt-3">
          Every form of support &mdash; financial, institutional, or in-kind &mdash; goes directly toward expanding access for Southcoast students.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {pillars.map(pillar => (
          <div class="card flex flex-col gap-4 text-center items-center">
            <div class="w-14 h-14 rounded-2xl bg-navy/5 flex items-center justify-center">
              <svg
                class="w-7 h-7 text-navy"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.75"
                  d={pillar.icon}
                />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-semibold text-navy mb-2">{pillar.title}</h3>
              <p class="text-navy-dark/65 text-sm leading-relaxed">{pillar.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why it matters -->
  <section class="bg-gray-50 border-y border-gray-100 py-14 md:py-16 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-navy mb-5">
        Why the Southcoast?
      </h2>
      <p class="text-navy-dark/70 leading-relaxed text-base md:text-lg mb-4">
        New Bedford and the surrounding Southcoast communities are home to thousands of talented high school students who never receive the college guidance they need and deserve. Most independent school students benefit from a dedicated college counselor managing a caseload of 10&ndash;15 students. In public schools, that ratio can exceed 400:1.
      </p>
      <p class="text-navy-dark/70 leading-relaxed text-base md:text-lg">
        Prep Up closes that gap &mdash; at no cost to students and families.
      </p>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-16 md:py-20 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-navy mb-4">
        Get in touch to learn more about supporting Prep Up.
      </h2>
      <p class="text-navy-dark/65 mb-8 leading-relaxed">
        All funding inquiries and partnership conversations start with a simple email. We&rsquo;d love to hear from you.
      </p>
      <a href="/contact" class="btn-primary text-base px-8 py-3.5">Contact Us</a>
    </div>
  </section>

  <!-- CTA strip -->
  <CTAStrip
    headline="Every dollar invested in Prep Up opens a door for a Southcoast student."
    primaryCTA={{ label: 'Contact Us to Support', href: '/contact' }}
    secondaryCTA={{ label: 'Learn About Our Program', href: '/program' }}
  />

</BaseLayout>

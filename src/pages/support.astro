---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTAStrip from '../components/CTAStrip.astro';

const pillars = [
  {
    number: 1,
    title: 'Private Donors',
    description:
      'Fueling initial access through community-led philanthropy. Individual contributions of any size help us expand our cohort capacity and deepen our support for each student.',
    tag: 'Individuals & Families',
  },
  {
    number: 2,
    title: 'Corporate Partners',
    description:
      'Investing in the local talent they will hire one day. Southcoast businesses that partner with Prep Up are building a more educated, more competitive regional workforce.',
    tag: 'Local Business',
  },
  {
    number: 3,
    title: 'Grant Funding',
    description:
      'Integrating with local education initiatives. Prep Up is positioned to partner with foundations and grant-makers committed to closing equity gaps in higher education access across Massachusetts.',
    tag: 'Foundations',
  },
];
---

<BaseLayout
  title="Support Us"
  description="Support Prep Up's mission to provide free college counseling to Southcoast students. Learn how private donors, corporate partners, and grant-makers can get involved."
>

  <PageHeader
    edition="04"
    label="Make a Difference"
    title="Support"
    titleAccent="our mission."
    subtitle="Prep Up is sustained by community-led generosity. Whether you're a private donor, a local business, or a grantmaking foundation, your support fuels equitable college access for Southcoast students."
  />

  <!-- Funding pillars -->
  <section class="py-28 md:py-36 px-6 grain">
    <div class="container-x-wide">
      <div class="mb-20" data-reveal>
        <div class="flex items-center gap-3 mb-8">
          <span class="editorial-label">Ways to Give</span>
          <span class="h-px w-10 bg-navy-ink/20"></span>
          <span class="editorial-label">Three pathways</span>
        </div>
        <h2 class="font-display text-4xl md:text-6xl lg:text-7xl font-medium text-navy-ink leading-[0.95] tracking-tightest max-w-5xl">
          Three ways<br/>
          <span class="italic font-light text-navy-ink/65">to support Prep Up.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-y-16 gap-x-12 md:gap-x-16">
        {pillars.map((p, i) => (
          <article class="group relative" data-reveal data-reveal-delay={i * 120}>
            <div class="flex items-end gap-4 mb-6">
              <span class="font-display font-light text-7xl md:text-8xl leading-[0.85] text-navy-ink/[0.16] tracking-tightest transition-colors duration-500 group-hover:text-gold/60">
                {String(p.number).padStart(2, '0')}
              </span>
              <div class="flex-1 pb-3">
                <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-navy-ink/40 mb-2">{p.tag}</p>
                <div class="h-[1.5px] w-full bg-navy-ink/15 transition-colors duration-700 group-hover:bg-gold/60"></div>
              </div>
            </div>
            <h3 class="font-display text-2xl md:text-[1.7rem] font-medium text-navy-ink leading-tight tracking-tight mb-4">
              {p.title}
            </h3>
            <p class="text-navy-ink/70 leading-[1.65] font-light text-[15px]">{p.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Why the Southcoast: editorial stats section -->
  <section class="bg-white border-y border-navy-ink/[0.08] py-28 md:py-36 px-6">
    <div class="container-x-wide">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">

        <div class="md:col-span-5" data-reveal>
          <div class="flex items-center gap-3 mb-8">
            <span class="editorial-label">The Why</span>
            <span class="h-px w-10 bg-navy-ink/20"></span>
          </div>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-medium text-navy-ink leading-[0.95] tracking-tightest mb-6">
            Why the<br/>
            <span class="italic font-light text-gold-dark">Southcoast?</span>
          </h2>
        </div>

        <div class="md:col-span-7 space-y-10" data-reveal data-reveal-delay="100">

          <p class="text-navy-ink/80 leading-[1.7] text-base md:text-[17px] font-light max-w-2xl">
            New Bedford and the surrounding Southcoast communities are home to thousands of talented high school students who never receive the college guidance they need and deserve.
          </p>

          <!-- Stats row -->
          <div class="grid grid-cols-2 gap-8 md:gap-10 border-y border-navy-ink/10 py-10">
            <div>
              <p class="font-display text-5xl md:text-6xl font-light text-navy-ink tracking-tightest leading-none mb-2">
                10<span class="text-navy-ink/40">:</span>1
              </p>
              <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-navy-ink/50">Independent school ratio</p>
            </div>
            <div>
              <p class="font-display text-5xl md:text-6xl font-light text-gold-dark tracking-tightest leading-none mb-2">
                400<span class="text-gold-dark/40">:</span>1
              </p>
              <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-navy-ink/50">Public school ratio</p>
            </div>
          </div>

          <p class="font-display text-2xl md:text-3xl lg:text-[1.9rem] font-light text-navy-ink leading-[1.3] tracking-tight italic max-w-xl">
            Prep Up closes that gap — at <span class="text-gold-dark not-italic font-medium">no cost</span> to students and families.
          </p>

        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <CTAStrip
    eyebrow="Get involved"
    headline="Every dollar invested in Prep Up opens"
    headlineAccent="a door for a Southcoast student."
    primaryCTA={{ label: 'Contact Us', href: '/contact' }}
    secondaryCTA={{ label: 'Learn about the program', href: '/program' }}
  />

</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const email = 'stuart.titus@gmail.com';
const phoneDisplay = '(978) 766-8733';
const phoneHref = 'tel:+19787668733';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Prep Up Southcoast. Reach us by email or phone, or visit us in New Bedford, MA."
>

  <PageHeader
    title="Contact"
    titleAccent="us."
    subtitle="Reach Prep Up by email or phone, or visit us in New Bedford."
  />

  <!-- Contact content -->
  <section class="py-28 md:py-36 px-6 grain">
    <div class="container-narrow">

      <!-- Email as headline treatment -->
      <div class="mb-12" data-reveal>
        <a
          href={`mailto:${email}`}
          class="group inline-block"
        >
          <p class="font-display text-3xl md:text-5xl lg:text-[3.5rem] font-medium text-navy-ink leading-tight tracking-tightest transition-colors duration-300 group-hover:text-gold-dark break-words">
            {email}
          </p>
        </a>
      </div>

      <!-- Phone, second headline treatment -->
      <div class="mb-16" data-reveal data-reveal-delay="60">
        <a
          href={phoneHref}
          class="group inline-block"
        >
          <p class="font-display text-2xl md:text-4xl lg:text-[3rem] font-light text-navy-ink leading-tight tracking-tightest transition-colors duration-300 group-hover:text-gold-dark">
            {phoneDisplay}
          </p>
        </a>
      </div>

      <!-- Divider -->
      <div class="gold-divider mb-16"></div>

      <!-- Address -->
      <div data-reveal data-reveal-delay="80">
        <address class="not-italic font-display text-2xl md:text-3xl font-light text-navy-ink leading-tight tracking-tight mb-3">
          1265 Purchase Street<br/>
          New Bedford,<br/>
          <span class="italic">Massachusetts</span> 02740
        </address>
      </div>

      <!-- Big email button -->
      <div class="mt-16 flex flex-col sm:flex-row items-start sm:items-center gap-6" data-reveal data-reveal-delay="160">
        <a href={`mailto:${email}`} class="btn-primary">
          <span>Email Us</span>
          <span class="arrow">→</span>
        </a>
        <a href="/support" class="text-link text-navy-ink hover:text-gold-dark text-base">
          <span>Or learn how to support us</span>
          <span class="arrow">↗</span>
        </a>
      </div>

    </div>
  </section>
</BaseLayout>

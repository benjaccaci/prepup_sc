---
import BaseLayout from '../layouts/BaseLayout.astro';

const email = 'info@prepupsouthcoast.org';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Prep Up Southcoast. Reach us at info@prepupsouthcoast.org or visit us in New Bedford, MA."
>

  <!-- Page header -->
  <header class="bg-navy text-white py-16 md:py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs font-semibold text-gold tracking-widest uppercase mb-3">Reach Out</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight">Contact Us</h1>
    </div>
  </header>

  <!-- Contact content -->
  <section class="py-16 md:py-24 px-6">
    <div class="max-w-xl mx-auto text-center">

      <!-- Intro -->
      <p class="text-navy-dark/70 text-lg leading-relaxed mb-12">
        Whether you&rsquo;re a student or family member interested in the program, a donor or corporate partner, or just curious about what we do &mdash; we&rsquo;d love to hear from you.
      </p>

      <!-- Contact card -->
      <div class="card border-gray-200 divide-y divide-gray-100">

        <!-- Email -->
        <div class="pb-6 mb-6">
          <p class="text-xs font-semibold text-slate-accent uppercase tracking-widest mb-2">Email</p>
          <a
            href={`mailto:${email}`}
            class="font-serif text-xl md:text-2xl font-semibold text-navy hover:text-gold-dark transition-colors"
          >
            {email}
          </a>
        </div>

        <!-- Address -->
        <div class="pt-6">
          <p class="text-xs font-semibold text-slate-accent uppercase tracking-widest mb-2">Address</p>
          <address class="not-italic text-navy-dark/75 text-base leading-relaxed">
            1265 Purchase Street<br />
            New Bedford, MA 02740
          </address>
        </div>

      </div>

      <!-- Primary email button -->
      <div class="mt-8">
        <a
          href={`mailto:${email}`}
          class="btn-primary text-base px-10 py-4 inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Email Us
        </a>
      </div>

      <!-- Helpful context -->
      <p class="mt-8 text-sm text-navy-dark/50">
        We respond to all inquiries within two business days.
      </p>

    </div>
  </section>

  <!-- Subtle CTA at bottom -->
  <section class="bg-gray-50 border-t border-gray-100 py-12 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-navy-dark/65 text-sm">
        Interested in supporting Prep Up?
        <a href="/support" class="text-navy font-semibold hover:text-gold-dark transition-colors ml-1">
          Learn about ways to give →
        </a>
      </p>
    </div>
  </section>

</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const email = 'info@prepupsouthcoast.org';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Prep Up Southcoast. Reach us at info@prepupsouthcoast.org or visit us in New Bedford, MA."
>

  <PageHeader
    edition="05"
    label="Reach Out"
    title="Contact"
    titleAccent="us."
    subtitle="Reach Prep Up by email, or visit us in New Bedford."
  />

  <!-- Contact content -->
  <section class="py-28 md:py-36 px-6 grain">
    <div class="container-narrow">

      <!-- Email as headline treatment -->
      <div class="mb-16" data-reveal>
        <div class="flex items-center gap-3 mb-10">
          <span class="editorial-label">Primary Contact</span>
          <span class="h-px w-10 bg-navy-ink/20"></span>
          <span class="editorial-label">By email</span>
        </div>

        <a
          href={`mailto:${email}`}
          class="group inline-block"
        >
          <p class="font-display text-3xl md:text-5xl lg:text-[3.5rem] font-medium text-navy-ink leading-tight tracking-tightest mb-4 transition-colors duration-300 group-hover:text-gold-dark break-words">
            {email}
          </p>
          <div class="flex items-center gap-3 text-navy-ink/60 group-hover:text-gold-dark transition-colors">
            <span class="font-mono text-[11px] uppercase tracking-[0.22em]">Click to compose</span>
            <span class="h-px w-8 bg-current transition-all duration-500 group-hover:w-16"></span>
            <span>↗</span>
          </div>
        </a>
      </div>

      <!-- Divider -->
      <div class="gold-divider mb-16"></div>

      <!-- Address -->
      <div data-reveal data-reveal-delay="80">
        <p class="editorial-label mb-4">Visit</p>
        <address class="not-italic font-display text-2xl md:text-3xl font-light text-navy-ink leading-tight tracking-tight mb-3">
          1265 Purchase Street<br/>
          New Bedford,<br/>
          <span class="italic">Massachusetts</span> 02740
        </address>
      </div>

      <!-- Big email button -->
      <div class="mt-16 flex flex-col sm:flex-row items-start sm:items-center gap-6" data-reveal data-reveal-delay="160">
        <a href={`mailto:${email}`} class="btn-primary">
          <span>Email Us</span>
          <span class="arrow">→</span>
        </a>
        <a href="/support" class="text-link text-navy-ink hover:text-gold-dark text-base">
          <span>Or learn how to support us</span>
          <span class="arrow">↗</span>
        </a>
      </div>

    </div>
  </section>
</BaseLayout>

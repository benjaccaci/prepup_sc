---
interface Props {
  title: string;
  titleAccent?: string;
  subtitle?: string;
}

const { title, titleAccent, subtitle } = Astro.props;
---

<header class="relative bg-navy-dark text-paper grain overflow-hidden">

  <!-- Background decoration -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute inset-0 grid-lines text-paper opacity-[0.04]"></div>
    <div class="absolute -top-1/3 -right-1/4 w-[640px] h-[640px] rounded-full bg-gold/[0.08] blur-3xl"></div>
  </div>

  <div class="relative container-x-wide pt-24 pb-24 md:pt-32 md:pb-32">

    <!-- Headline -->
    <h1
      class="font-display font-medium leading-[0.95] tracking-tightest text-paper max-w-[1100px]"
      style="font-size: clamp(2.5rem, 7.5vw, 7.5rem);"
      data-reveal
    >
      {title}
      {titleAccent && (
        <>
          <br/>
          <span class="italic font-light text-gold">{titleAccent}</span>
        </>
      )}
    </h1>

    {subtitle && (
      <p
        class="mt-10 md:mt-14 max-w-2xl text-base md:text-xl text-paper/70 leading-[1.65] font-light"
        data-reveal
        data-reveal-delay="120"
      >
        {subtitle}
      </p>
    )}
  </div>
</header>

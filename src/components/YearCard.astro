---
interface Season {
  name: string;
  activities: string;
}

interface Props {
  grade: string;
  theme: string;
  focus?: string;
  emphasis: string;
  strategicOutcome: string;
  seasons: Season[];
}

const { grade, theme, focus, emphasis, strategicOutcome, seasons } = Astro.props;

const gradeBadgeColors: Record<string, string> = {
  '9th': 'bg-navy text-white',
  '10th': 'bg-navy text-white',
  '11th': 'bg-navy text-white',
  '12th': 'bg-gold text-navy-dark',
};

const gradeNum = grade.split('th')[0].split('st')[0].split('nd')[0].split('rd')[0];
const badgeColor = gradeBadgeColors[`${gradeNum}th`] ?? 'bg-navy text-white';
---

<article class="card flex flex-col gap-4">
  <!-- Grade badge + theme -->
  <div class="flex items-start gap-3">
    <span class={`shrink-0 inline-block px-3 py-1 rounded-lg text-sm font-bold tracking-wide ${badgeColor}`}>
      {grade}
    </span>
    <h3 class="font-serif text-xl font-semibold text-navy leading-snug">{theme}</h3>
  </div>

  <!-- Divider -->
  <div class="h-px bg-gray-100"></div>

  {focus && (
    <div>
      <p class="text-xs font-semibold text-slate-accent uppercase tracking-widest mb-1">Focus</p>
      <p class="text-sm text-navy-dark/75">{focus}</p>
    </div>
  )}

  <div>
    <p class="text-xs font-semibold text-slate-accent uppercase tracking-widest mb-1">Emphasis</p>
    <p class="text-sm text-navy-dark/75">{emphasis}</p>
  </div>

  <div>
    <p class="text-xs font-semibold text-slate-accent uppercase tracking-widest mb-1">Strategic Outcome</p>
    <p class="text-sm text-navy-dark/75 leading-relaxed">{strategicOutcome}</p>
  </div>

  <!-- Seasonal rhythm -->
  <div>
    <p class="text-xs font-semibold text-slate-accent uppercase tracking-widest mb-2">Seasonal Rhythm</p>
    <ul class="space-y-2">
      {seasons.map(season => (
        <li class="flex gap-2 text-sm">
          <span class="shrink-0 font-semibold text-gold-dark min-w-[72px]">{season.name}:</span>
          <span class="text-navy-dark/70">{season.activities}</span>
        </li>
      ))}
    </ul>
  </div>
</article>

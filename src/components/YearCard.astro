---
interface Season {
  name: string;
  activities: string;
}

interface Props {
  grade: string;
  yearNumber: string;
  ordinal: string;
  theme: string;
  focus?: string;
  emphasis: string;
  strategicOutcome: string;
  seasons: Season[];
  index: number;
}

const {
  grade,
  yearNumber,
  ordinal,
  theme,
  focus,
  emphasis,
  strategicOutcome,
  seasons,
  index,
} = Astro.props;
---

<article
  class="relative bg-white border border-navy-ink/[0.08] rounded-3xl p-8 md:p-10 transition-all duration-500 ease-out hover:border-gold/40 hover:shadow-2xl hover:shadow-navy-ink/[0.06] group overflow-hidden"
  data-reveal
  data-reveal-delay={index * 120}
>

  <!-- Top: index + grade -->
  <div class="flex items-baseline justify-between mb-8">
    <span class="editorial-label">№ {String(index + 1).padStart(2, '0')}</span>
    <span class="editorial-label">{grade}</span>
  </div>

  <!-- Massive year numeral -->
  <div class="mb-6 flex items-end gap-2 leading-none relative">
    <span
      class="font-display font-light text-[8.5rem] md:text-[10rem] text-navy-ink tracking-tightest leading-[0.82] transition-transform duration-700 ease-out group-hover:-translate-y-2"
      style="font-variation-settings: 'opsz' 144, 'SOFT' 30;"
    >
      {yearNumber}
    </span>
    <span class="font-display font-medium italic text-2xl md:text-3xl text-gold-dark mb-3 tracking-tight">
      {ordinal}
    </span>
  </div>

  <!-- Theme -->
  <h3 class="font-display text-2xl md:text-3xl font-medium text-navy-ink leading-[1.15] tracking-tight mb-4">
    {theme}
  </h3>

  <!-- Gold divider -->
  <div class="h-[2px] w-12 bg-gold mb-8 origin-left transition-transform duration-500 group-hover:scale-x-[2]"></div>

  <!-- Content sections -->
  <div class="space-y-7">

    {focus && (
      <div>
        <p class="editorial-label mb-2">Focus</p>
        <p class="text-navy-ink/75 leading-[1.6] text-[15px] font-light">{focus}</p>
      </div>
    )}

    <div>
      <p class="editorial-label mb-2">Emphasis</p>
      <p class="text-navy-ink/75 leading-[1.6] text-[15px] font-light">{emphasis}</p>
    </div>

    <div>
      <p class="editorial-label mb-2">Strategic Outcome</p>
      <p class="text-navy-ink/75 leading-[1.6] text-[15px] font-light">{strategicOutcome}</p>
    </div>

    <div>
      <p class="editorial-label mb-3">Seasonal Rhythm</p>
      <ul class="space-y-3.5 border-l-2 border-gold/30 pl-5">
        {seasons.map(season => (
          <li>
            <p class="font-display italic text-gold-dark text-base mb-1 tracking-tight">
              {season.name}
            </p>
            <p class="text-navy-ink/65 text-[14px] leading-[1.6] font-light">
              {season.activities}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</article>

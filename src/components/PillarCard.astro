---
interface Props {
  number: number;
  title: string;
  description: string;
  index?: number;
}

const { number, title, description, index = 0 } = Astro.props;
---

<article class="group relative" data-reveal data-reveal-delay={index * 120}>
  <div class="flex flex-col gap-7">

    <!-- Numeric + line -->
    <div class="flex items-end gap-5">
      <span class="font-display font-light text-7xl md:text-8xl leading-[0.85] text-navy-ink/[0.16] tracking-tightest transition-all duration-500 ease-out group-hover:text-gold/60 group-hover:-translate-y-1">
        {String(number).padStart(2, '0')}
      </span>
      <div class="flex-1 pb-3">
        <div class="h-[1.5px] w-full bg-navy-ink/15 transition-all duration-700 ease-out group-hover:bg-gold/60"></div>
      </div>
    </div>

    <!-- Title -->
    <h3 class="font-display text-2xl md:text-[1.7rem] font-medium text-navy-ink leading-tight tracking-tight">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-navy-ink/70 leading-[1.65] font-light text-[15px] md:text-base">{description}</p>
  </div>
</article>

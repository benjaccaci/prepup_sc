---
interface CTA {
  label: string;
  href: string;
}

interface Props {
  primaryCTA?: CTA;
  secondaryCTA?: CTA;
}

const { primaryCTA, secondaryCTA } = Astro.props;
---

<section class="relative bg-navy-dark text-paper grain overflow-hidden min-h-screen flex items-center">

  <!-- Background decoration: vertical lines + glow -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute inset-0 grid-lines text-paper opacity-[0.05]"></div>
    <div class="absolute top-[15%] -right-32 w-[640px] h-[640px] rounded-full bg-gold/[0.09] blur-3xl"></div>
    <div class="absolute -bottom-1/4 -left-32 w-[520px] h-[520px] rounded-full bg-navy/40 blur-3xl"></div>
  </div>

  <div class="relative container-x-wide w-full py-16 md:py-20">

    <!-- Two-column hero: text content stacked on the left, photo stretches alongside on the right -->
    <div class="flex flex-col md:flex-row md:items-stretch gap-10 md:gap-12 lg:gap-16">

      <!-- Left: stacked headline + subhead + CTAs -->
      <div class="md:flex-1 md:max-w-3xl flex flex-col justify-center gap-8 md:gap-10">

        <!-- Headline -->
        <h1
          class="font-display font-medium leading-[0.92] tracking-tightest text-paper"
          style="font-size: clamp(2.25rem, 6vw, 5.75rem);"
          data-reveal
          data-reveal-delay="60"
        >
          <span class="block">College</span>
          <span class="block">Access</span>
          <span class="relative inline-block">
            for <span class="italic font-light">All</span>
            <span class="absolute -bottom-1 md:-bottom-2 left-0 right-0 h-[4px] md:h-[6px] bg-gold origin-left animate-draw-line rounded-full"></span>
          </span>
        </h1>

        <!-- Subhead -->
        <p
          class="text-base md:text-xl text-paper/70 max-w-xl leading-[1.6] font-light"
          data-reveal
          data-reveal-delay="180"
        >
          Equitable, process-driven college guidance for Southcoast students who face barriers to higher education.
        </p>

        <!-- CTAs -->
        {(primaryCTA || secondaryCTA) && (
          <div class="flex flex-col sm:flex-row gap-6 sm:items-center" data-reveal data-reveal-delay="280">
            {primaryCTA && (
              <a href={primaryCTA.href} class="btn-primary">
                <span>{primaryCTA.label}</span>
                <span class="arrow">→</span>
              </a>
            )}
            {secondaryCTA && (
              <a href={secondaryCTA.href} class="text-link text-paper/85 hover:text-gold">
                <span>{secondaryCTA.label}</span>
                <span class="arrow">↗</span>
              </a>
            )}
          </div>
        )}
      </div>

      <!-- Right: photo. md:items-stretch on the parent makes it match the left column's full height. -->
      <figure
        class="relative md:flex-1 md:max-w-[30rem] xl:max-w-[34rem] min-h-[28rem] md:min-h-0 overflow-hidden rounded-2xl shadow-2xl shadow-black/50 ring-1 ring-paper/10"
        data-reveal
        data-reveal-delay="120"
      >
        <img
          src="/images/students/graduation_title.jpg"
          alt="A Prep Up student at their college graduation."
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
        <!-- subtle bottom-to-top navy gradient so the photo blends into the dark hero -->
        <div
          class="absolute inset-0 pointer-events-none mix-blend-multiply"
          style="background: linear-gradient(180deg, rgba(15,31,61,0) 55%, rgba(10,24,48,0.35) 100%);"
        ></div>
        <!-- editorial gold rules top + bottom -->
        <span class="absolute top-0 inset-x-0 h-px bg-gold/65"></span>
        <span class="absolute bottom-0 inset-x-0 h-px bg-gold/55"></span>
      </figure>

    </div>

  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 hidden md:flex items-center gap-3 opacity-60 animate-fade-in" style="animation-delay: 1.2s;">
    <span class="editorial-label-light">Scroll</span>
    <span class="block h-px w-12 bg-paper/40"></span>
    <span class="text-paper/40 text-xs">↓</span>
  </div>
</section>

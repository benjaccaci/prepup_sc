---
const year = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/program', label: 'Program' },
  { href: '/support', label: 'Support Us' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="relative bg-navy-dark text-paper grain overflow-hidden">

  <!-- Top gold rule -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold to-transparent"></div>

  <div class="container-x-wide pt-20 pb-12 md:pt-24 md:pb-12 relative">

    <!-- Top: Brand + columns -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-20 pb-16 border-b border-paper/10">

      <!-- Brand mark -->
      <div class="md:col-span-5">
        <a href="/" class="inline-flex items-center gap-4 mb-7 group" aria-label="Prep Up Southcoast">
          <img src="/logo-badge.png" alt="Prep Up" class="h-16 w-auto transition-transform duration-700 ease-out group-hover:rotate-[8deg]" />
          <div>
            <p class="font-display text-2xl font-medium text-paper leading-none tracking-tightest">Prep Up</p>
            <p class="editorial-label-light mt-1.5">College Access for All</p>
          </div>
        </a>
        <p class="text-paper/60 leading-[1.7] max-w-md text-base font-light">
          A non-profit providing equitable, process-driven college guidance to Southcoast students who face barriers to higher education.
        </p>
      </div>

      <!-- Visit -->
      <div class="md:col-span-3">
        <p class="editorial-label-light mb-5">Visit</p>
        <address class="not-italic text-paper/75 leading-[1.7] font-light">
          1265 Purchase Street<br />
          New Bedford, MA 02740
        </address>
      </div>

      <!-- Contact -->
      <div class="md:col-span-2">
        <p class="editorial-label-light mb-5">Contact</p>
        <a
          href="mailto:info@prepupsouthcoast.org"
          class="text-paper/75 hover:text-gold transition-colors text-sm font-light leading-relaxed break-words"
        >
          info@<wbr/>prepupsouthcoast.org
        </a>
      </div>

      <!-- Nav -->
      <div class="md:col-span-2">
        <p class="editorial-label-light mb-5">Navigate</p>
        <ul class="space-y-2.5">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="text-paper/75 hover:text-gold transition-colors text-sm font-light"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Big editorial tagline -->
    <div class="mb-20 overflow-hidden">
      <p class="font-display text-[11vw] md:text-[8vw] lg:text-[7rem] xl:text-[8.5rem] font-light leading-[0.95] tracking-tightest text-paper/85">
        Closing the<br/>
        <span class="italic text-gold">guidance gap.</span>
      </p>
    </div>

    <!-- Bottom -->
    <div class="flex flex-col md:flex-row items-start md:items-center gap-3">
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-paper/40">© {year} Prep Up · All rights reserved</p>
    </div>

  </div>
</footer>

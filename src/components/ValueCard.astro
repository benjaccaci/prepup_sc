---
interface Props {
  title: string;
  description: string;
  /** One of: equity | partnership | aspiration */
  icon: 'equity' | 'partnership' | 'aspiration';
}

const { title, description, icon } = Astro.props;

const icons: Record<string, string> = {
  equity:
    'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3',
  partnership:
    'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
  aspiration:
    'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
};
---

<div class="card flex gap-5">
  <div class="shrink-0 w-12 h-12 rounded-xl bg-gold/10 flex items-center justify-center">
    <svg
      class="w-6 h-6 text-gold-dark"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={icons[icon]} />
    </svg>
  </div>
  <div>
    <h3 class="font-serif text-lg font-semibold text-navy mb-1.5">{title}</h3>
    <p class="text-navy-dark/65 text-sm leading-relaxed">{description}</p>
  </div>
</div>

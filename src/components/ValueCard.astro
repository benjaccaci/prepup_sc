---
interface Props {
  title: string;
  description: string;
  number: number;
  /** Kept for backwards compatibility — no longer rendered. */
  icon?: string;
}

const { title, description, number } = Astro.props;
---

<article
  class="relative pl-8 group"
  data-reveal
  data-reveal-delay={(number - 1) * 120}
>
  <!-- Vertical gold accent line -->
  <span class="absolute left-0 top-0 bottom-0 w-px bg-gold/40 group-hover:bg-gold transition-colors duration-500"></span>

  <!-- Number indicator -->
  <span
    class="absolute -left-[11px] top-0 w-[22px] h-[22px] rounded-full bg-paper border border-gold flex items-center justify-center transition-all duration-300 ease-out group-hover:bg-gold group-hover:scale-110"
  >
    <span class="font-mono text-[9px] font-bold text-gold-dark group-hover:text-navy-ink transition-colors leading-none">
      0{number}
    </span>
  </span>

  <h3 class="font-display text-2xl md:text-3xl font-medium text-navy-ink leading-tight tracking-tight mb-4">
    {title}
  </h3>

  <div class="h-px w-12 bg-gold mb-5 origin-left transition-transform duration-500 group-hover:scale-x-150"></div>

  <p class="text-navy-ink/70 leading-[1.65] font-light text-[15px]">{description}</p>
</article>

---
interface CTA {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  headlineAccent?: string;
  primaryCTA: CTA;
  secondaryCTA?: CTA;
}

const { eyebrow, headline, headlineAccent, primaryCTA, secondaryCTA } = Astro.props;
---

<section class="relative bg-navy-dark text-paper grain overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-1/2 left-1/3 w-[700px] h-[700px] rounded-full bg-gold/[0.08] blur-3xl"></div>
  </div>

  <div class="relative container-x-wide py-24 md:py-32">
    <div class="max-w-5xl">

      {eyebrow && (
        <div class="flex items-center gap-3 mb-8" data-reveal>
          <span class="editorial-label-light">{eyebrow}</span>
          <span class="h-px w-12 bg-paper/30"></span>
        </div>
      )}

      <h2
        class="font-display text-4xl md:text-6xl lg:text-7xl font-medium leading-[1.05] tracking-tightest mb-12 md:mb-14 text-paper"
        data-reveal
        data-reveal-delay="80"
      >
        {headline}
        {headlineAccent && (
          <>
            {' '}<span class="italic font-light text-gold">{headlineAccent}</span>
          </>
        )}
      </h2>

      <div class="flex flex-col sm:flex-row gap-6 sm:items-center" data-reveal data-reveal-delay="200">
        <a href={primaryCTA.href} class="btn-primary">
          <span>{primaryCTA.label}</span>
          <span class="arrow">→</span>
        </a>
        {secondaryCTA && (
          <a href={secondaryCTA.href} class="text-link text-paper/85 hover:text-gold">
            <span>{secondaryCTA.label}</span>
            <span class="arrow">↗</span>
          </a>
        )}
      </div>
    </div>
  </div>
</section>

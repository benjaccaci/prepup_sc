---
interface Props {
  name: string;
  bio: string;
  initials: string;
  reversed?: boolean;
  index?: number;
}

const { name, bio, initials, reversed = false, index = 0 } = Astro.props;
---

<article
  class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-start"
  data-reveal
  data-reveal-delay={index * 100}
>
  <!-- Photo placeholder column -->
  <div class={`md:col-span-5 ${reversed ? 'md:col-start-8 md:row-start-1' : ''}`}>
    <div class="relative aspect-[4/5] overflow-hidden rounded-sm group">

      <!-- Background gradient -->
      <div class="absolute inset-0 bg-gradient-to-br from-navy via-navy-dark to-navy-ink"></div>

      <!-- Subtle gold glow -->
      <div
        class="absolute inset-0 mix-blend-overlay transition-opacity duration-700 group-hover:opacity-80"
        style="background-image: radial-gradient(circle at 30% 30%, rgba(242,183,54,0.45) 0%, transparent 55%);"
      ></div>

      <!-- Grain overlay -->
      <div
        class="absolute inset-0 opacity-[0.12] mix-blend-overlay pointer-events-none"
        style="background-image: url(&quot;data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);"
      ></div>

      <!-- Initials -->
      <div class="absolute inset-0 flex items-center justify-center">
        <span
          class="font-display font-light text-[8rem] md:text-[10rem] text-gold/80 tracking-tightest leading-none transition-transform duration-700 ease-out group-hover:scale-105"
          style="font-variation-settings: 'opsz' 144, 'SOFT' 30;"
        >
          {initials}
        </span>
      </div>

      <!-- Frame indicators -->
      <span class="absolute top-5 left-5 editorial-label-light">Photo Forthcoming</span>
      <span class="absolute bottom-5 right-5 font-display text-paper/35 text-sm tabular-nums">
        № 0{index + 1}
      </span>

      <!-- Top frame line -->
      <span class="absolute top-0 left-5 right-5 h-px bg-paper/15"></span>
      <span class="absolute bottom-0 left-5 right-5 h-px bg-paper/15"></span>
    </div>
  </div>

  <!-- Bio column -->
  <div class={`md:col-span-7 md:pt-6 ${reversed ? 'md:col-start-1 md:row-start-1' : ''}`}>

    <p class="editorial-label mb-3">Founder · 0{index + 1}</p>

    <h3 class="font-display text-4xl md:text-5xl lg:text-6xl font-medium text-navy-ink leading-[0.95] tracking-tightest mb-6">
      {name}
    </h3>

    <div class="flex items-center gap-3 mb-8">
      <span class="h-[2px] w-16 bg-gold"></span>
      <span class="font-display italic font-light text-navy-ink/60 text-lg">Co-founder</span>
    </div>

    <p class="text-navy-ink/75 leading-[1.7] font-light text-base md:text-[17px] max-w-xl">
      {bio}
    </p>
  </div>
</article>
